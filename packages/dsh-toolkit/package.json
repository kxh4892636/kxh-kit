{
  "name": "@kxh4892636/dsh-toolkit",
  "version": "0.4.1",
  "description": "DSH plugin: a toolkit of independently switchable tools — nested skill discovery, one-click turn undo, plus the Nano Flow agent preset.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node scripts/copy-nano-flow-assets.mjs && node scripts/wrap-client.mjs",
    "check": "vp check",
    "test": "vp test src",
    "test:coverage": "vp test --run --coverage",
    "prepack": "vp run --no-cache build"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-fs": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.3",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
