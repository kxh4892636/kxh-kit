{
  "name": "@kxh4892636/pi-nested-skill",
  "version": "0.1.0",
  "description": "Pi extension for nested skill discovery and inline multi-skill expansion.",
  "keywords": [
    "pi-package",
    "skill"
  ],
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test src",
    "test:coverage": "vp test --run --coverage src"
  },
  "dependencies": {
    "ignore": "7.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
