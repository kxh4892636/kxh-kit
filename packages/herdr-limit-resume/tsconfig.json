{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["src", "runtime/*.test.ts", "vite.config.ts"]
}
