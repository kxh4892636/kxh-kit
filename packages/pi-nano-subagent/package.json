{
  "name": "@kxh4892636/pi-nano-subagent",
  "version": "0.1.0",
  "description": "Minimal in-process Fresh Subagent delegation for Pi.",
  "keywords": [
    "pi-package",
    "subagent"
  ],
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "config-example.json",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test src",
    "test:coverage": "vp test --run --coverage src"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typebox": "1.3.7",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
