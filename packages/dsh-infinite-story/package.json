{
  "name": "@kxh4892636/dsh-infinite-story",
  "version": "0.1.0",
  "description": "DSH plugin: run a long-form story as a persistent state machine — rules in the system prompt, state on disk, drift blocked at write time.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "dist/main.mjs",
  "types": "dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "default": "./dist/main.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "vp pack && node scripts/build-client.mjs",
    "check": "vp check",
    "test": "vp test src"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^18.3.31",
    "@typescript/native": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3",
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}
