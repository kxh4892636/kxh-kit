{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "src",
    "outDir": ".test-dist",
    "noEmit": true
  },
  "include": ["src"]
}
