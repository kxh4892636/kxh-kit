{
  "name": "@kxh4892636/dsh-opencode-session",
  "version": "0.1.1",
  "description": "DSH plugin: attach the DSH session ID to model requests for every provider.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "dist/main.mjs",
  "types": "dist/main.d.mts",
  "exports": {
    ".": {
      "types": "./dist/main.d.mts",
      "default": "./dist/main.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "pack": "vp pack && pnpm pack --pack-destination ../..",
    "check": "vp check",
    "test": "vp test src",
    "test:coverage": "vp test --run --coverage",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
