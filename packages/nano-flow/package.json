    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "commander": "^15.0.0",
    "ipaddr.js": "^2.5.0",
    "ky": "^2.0.2",
    "mime": "^4.1.0",
    "semver": "^7.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "^7.8.0",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
