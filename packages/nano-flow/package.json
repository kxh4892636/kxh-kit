{
  "name": "@kxh4892636/nano-flow",
  "version": "0.0.1",
  "description": "Nano Flow unified command line interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kxh4892636/kxh-kit.git",
    "directory": "packages/nano-flow"
  },
  "bin": {
    "nnf": "dist/main.mjs"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "type": "module",
