{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "tsBuildInfoFile": ".docusaurus/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "@site/*": ["./*"]
    },
    "types": ["node", "react", "@docusaurus/module-type-aliases"]
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src"]
}
